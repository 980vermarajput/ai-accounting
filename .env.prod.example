# Production environment for docker-compose.prod.yml.
# Copy to .env.prod and fill in real values. NEVER commit .env.prod.
#
#   cp .env.prod.example .env.prod

# ─── Postgres (used by the postgres service + DATABASE_URL below) ────────────
POSTGRES_DB=ai_accounting
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# ─── App database / redis (internal compose hostnames) ──────────────────────
# Default: connect as the superuser (RLS inert). To enforce RLS, point this at
# the restricted app_user role and set RLS_ENFORCE=true + ADMIN_DATABASE_URL.
DATABASE_URL=postgresql://postgres:CHANGE_ME_strong_db_password@postgres:5432/ai_accounting?schema=public
REDIS_URL=redis://redis:6379

# ─── Row-Level Security (see apps/api/prisma/rls/README.md) ─────────────────
RLS_ENFORCE=false
# ADMIN_DATABASE_URL=postgresql://postgres:CHANGE_ME_strong_db_password@postgres:5432/ai_accounting?schema=public

# ─── Public URLs (your Cloudflare hostnames) ────────────────────────────────
CORS_ORIGIN=https://app.yourdomain.com
FRONTEND_URL=https://app.yourdomain.com
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
GOOGLE_REDIRECT_URI=https://api.yourdomain.com/api/auth/google/callback

# ─── Google OAuth (console.cloud.google.com/apis/credentials) ───────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Secrets — generate, don't reuse the examples ───────────────────────────
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"  (must be 32 bytes / 64 hex)
ENCRYPTION_KEY=

# ─── OpenAI (the only unavoidable running cost) ─────────────────────────────
OPENAI_API_KEY=

# ─── Spend protection ───────────────────────────────────────────────────────
DAILY_TOKEN_CAP_PER_FIRM=50000
MAX_QUERY_TOKENS=6000
DAILY_GLOBAL_TOKEN_ALERT=500000

# ─── Sync limits ────────────────────────────────────────────────────────────
SYNC_MAX_RESULTS=500
MAX_EMAILS_PER_SYNC=10000
DEFAULT_SYNC_MONTHS=24
SKIP_EMAIL_PATTERNS=noreply,newsletter,unsubscribe,no-reply,donotreply

# ─── Cloudflare Tunnel (Zero Trust → Networks → Tunnels → create → token) ───
CLOUDFLARE_TUNNEL_TOKEN=

# ─── Telegram bot (optional) ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
