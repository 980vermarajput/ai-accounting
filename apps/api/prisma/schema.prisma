// ─── AI Accounting — Prisma Schema ───────────────────
// All tables include firm_id for RLS multi-tenancy.
// pgvector extension enabled for embedding similarity search.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector", schema: "public"), uuidOssp(map: "uuid-ossp")]
}

// ─── Enums ───────────────────────────────────────────

enum Plan {
  trial
  starter
  pro
}

enum UserRole {
  admin
  member
}

enum DocumentSource {
  gmail
  drive
  upload
}

enum DocumentStatus {
  pending
  processing
  ready
  error
}

enum SyncType {
  gmail
  drive
}

enum SyncStatus {
  queued
  running
  completed
  failed
}

enum Feedback {
  positive
  negative
  none
}

enum AlertType {
  INVOICE_OVERDUE
  CLIENT_SILENT
  DEADLINE_DETECTED
  HIGH_RISK_LANGUAGE
  SYNC_FAILURE
  TOKEN_CAP_WARNING
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ─── Firms ───────────────────────────────────────────

model Firm {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String   @db.VarChar(255)
  slug              String   @unique @db.VarChar(100)
  plan               Plan     @default(trial)
  stripeCustomerId   String?  @map("stripe_customer_id") @db.VarChar(255)
  knowledgeSnapshot  String?  @map("knowledge_snapshot")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  users         User[]
  clients       Client[]
  documents     Document[]
  chunks        Chunk[]
  queries       Query[]
  auditLogs     AuditLog[]
  syncJobs      SyncJob[]
  chatSessions  ChatSession[]
  alerts        Alert[]
  briefings     DailyBriefing[]
  extractedDeadlines ExtractedDeadline[]
  invites       FirmInvite[]

  @@map("firms")
}

// ─── Users ───────────────────────────────────────────

model User {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firmId                 String    @map("firm_id") @db.Uuid
  email                  String    @unique @db.VarChar(255)
  name                   String    @db.VarChar(255)
  role                   UserRole  @default(member)
  googleRefreshTokenEnc  Bytes?    @map("google_refresh_token_enc")
  googleTokenIv          Bytes?    @map("google_token_iv")
  lastSyncAt             DateTime? @map("last_sync_at") @db.Timestamptz()
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  firm         Firm          @relation(fields: [firmId], references: [id], onDelete: Cascade)
  documents    Document[]
  queries      Query[]
  auditLogs    AuditLog[]
  syncJobs     SyncJob[]
  clients      Client[]
  chatSessions ChatSession[]
  invitesCreated  FirmInvite[] @relation("InviteCreator")
  invitesAccepted FirmInvite[] @relation("InviteAcceptor")

  @@index([firmId])
  @@map("users")
}

// ─── Clients ─────────────────────────────────────────

model Client {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firmId      String   @map("firm_id") @db.Uuid
  createdBy   String   @map("created_by") @db.Uuid
  name        String   @db.VarChar(255)
  identifier  String   @db.VarChar(100)
  emailDomain String?  @map("email_domain") @db.VarChar(255)
  metadata    Json?    @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  firm         Firm          @relation(fields: [firmId], references: [id], onDelete: Cascade)
  creator      User          @relation(fields: [createdBy], references: [id])
  documents    Document[]
  chunks       Chunk[]
  queries      Query[]
  chatSessions ChatSession[]
  chatMessages ChatMessage[]
  alerts       Alert[]
  extractedDeadlines ExtractedDeadline[]

  @@index([firmId])
  @@map("clients")
}

// ─── Documents ───────────────────────────────────────

model Document {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firmId         String         @map("firm_id") @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  clientId       String?        @map("client_id") @db.Uuid
  source         DocumentSource
  sourceId       String         @map("source_id") @db.VarChar(500)
  gmailThreadId  String?        @map("gmail_thread_id") @db.VarChar(255)
  filename       String         @db.VarChar(500)
  mimeType       String         @map("mime_type") @db.VarChar(100)
  s3Key          String         @map("s3_key") @db.VarChar(500)
  textHash       String         @map("text_hash") @db.VarChar(64)
  textExcerpt    String?        @map("text_excerpt")
  status         DocumentStatus @default(pending)
  errorMessage   String?        @map("error_message")
  summary            String?
  entities           Json?          @db.JsonB
  deadlineExtracted  Boolean        @default(false) @map("deadline_extracted")
  deadlineCount      Int            @default(0) @map("deadline_count")
  sourceDate         DateTime       @map("source_date") @db.Timestamptz()
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz()

  firm               Firm    @relation(fields: [firmId], references: [id], onDelete: Cascade)
  user               User    @relation(fields: [userId], references: [id])
  client             Client? @relation(fields: [clientId], references: [id])
  chunks             Chunk[]
  extractedDeadlines ExtractedDeadline[]

  @@index([firmId])
  @@index([firmId, source])
  @@index([firmId, clientId])
  @@index([gmailThreadId])
  @@map("documents")
}

// ─── Chunks (with pgvector embedding) ────────────────

model Chunk {
  id         String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId String                    @map("document_id") @db.Uuid
  firmId     String                    @map("firm_id") @db.Uuid
  clientId   String?                   @map("client_id") @db.Uuid
  chunkIndex Int                       @map("chunk_index")
  chunkText  String                    @map("chunk_text")
  // Prisma Unsupported() keeps the column in the schema so migrate dev won't drop it.
  // Reads/writes are done via $queryRaw / $executeRaw with explicit casts.
  embedding  Unsupported("vector(1536)")?
  tokenCount Int                       @map("token_count")
  metadata   Json?                     @db.JsonB
  createdAt  DateTime                  @default(now()) @map("created_at") @db.Timestamptz()

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  firm     Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  client   Client?  @relation(fields: [clientId], references: [id])

  @@index([firmId])
  @@index([documentId])
  @@map("chunks")
}

// ─── Queries (RAG chat history) ──────────────────────

model Query {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firmId             String   @map("firm_id") @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  clientId           String?  @map("client_id") @db.Uuid
  queryText          String   @map("query_text")
  responseText       String   @map("response_text")
  retrievedChunkIds  String[] @map("retrieved_chunk_ids") @db.Uuid
  chunksSentToLlm    Int      @map("chunks_sent_to_llm")
  llmModel           String   @map("llm_model") @db.VarChar(50)
  llmTokensPrompt    Int      @map("llm_tokens_prompt")
  llmTokensCompletion Int     @map("llm_tokens_completion")
  llmCostInr         Decimal  @map("llm_cost_inr") @db.Decimal(10, 4)
  latencyMs          Int      @map("latency_ms")
  retrievalLatencyMs Int      @map("retrieval_latency_ms")
  feedback           Feedback @default(none)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz()

  firm   Firm    @relation(fields: [firmId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id])
  client Client? @relation(fields: [clientId], references: [id])

  @@index([firmId])
  @@index([firmId, userId])
  @@map("queries")
}

// ─── Audit Logs ──────────────────────────────────────

model AuditLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firmId       String   @map("firm_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  action       String   @db.VarChar(100)
  resourceType String   @map("resource_type") @db.VarChar(50)
  resourceId   String?  @map("resource_id") @db.Uuid
  details      Json?    @db.JsonB
  ipAddress    String?  @map("ip_address") @db.Inet
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([firmId])
  @@index([firmId, action])
  @@map("audit_logs")
}

// ─── Sync Jobs ───────────────────────────────────────

model SyncJob {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firmId             String     @map("firm_id") @db.Uuid
  userId             String     @map("user_id") @db.Uuid
  type               SyncType
  status             SyncStatus @default(queued)
  documentsFound     Int        @default(0) @map("documents_found")
  documentsProcessed Int        @default(0) @map("documents_processed")
  keywords           String[]   @default([])
  includeAllKeywords Boolean    @default(true) @map("include_all_keywords")
  errorMessage       String?    @map("error_message")
  startedAt          DateTime?  @map("started_at") @db.Timestamptz()
  completedAt        DateTime?  @map("completed_at") @db.Timestamptz()
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz()

  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([firmId])
  @@index([firmId, userId])
  @@map("sync_jobs")
}

// ─── Chat Sessions & Messages ─────────────────────────

model ChatSession {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firmId       String        @map("firm_id") @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  clientId     String?       @map("client_id") @db.Uuid // Optional client context
  title        String?       @db.VarChar(200) // Auto-generated from first message
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  lastActivity DateTime      @default(now()) @map("last_activity") @db.Timestamptz(6)
  expiresAt    DateTime      @map("expires_at") @db.Timestamptz(6) // Auto-cleanup
  isActive     Boolean       @default(true) @map("is_active")

  // Relationships
  firm     Firm          @relation(fields: [firmId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  client   Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  messages ChatMessage[]

  @@index([firmId, userId])
  @@index([lastActivity]) // For cleanup queries
  @@index([expiresAt]) // For cleanup queries
  @@map("chat_sessions")
}

model ChatMessage {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId    String      @map("session_id") @db.Uuid
  role         MessageRole
  content      String      @db.Text
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  // Metadata for smart context management
  tokensUsed   Int?        @map("tokens_used") // Track token cost per message
  clientId     String?     @map("client_id") @db.Uuid // Track client context
  searchResults Int?       @map("search_results") // Number of doc chunks used
  toolsUsed    String[]    @default([]) @map("tools_used") // Track which AI tools were called

  // Relationships
  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  client  Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([sessionId, createdAt]) // For conversation ordering
  @@map("chat_messages")
}

enum MessageRole {
  user
  assistant
  system // For context/tool outputs
}

// ─── Extracted Deadlines ─────────────────────────────

model ExtractedDeadline {
  id          String   @id @default(cuid())
  firmId      String   @map("firm_id") @db.Uuid
  documentId  String   @map("document_id") @db.Uuid
  clientId    String?  @map("client_id") @db.Uuid
  date        DateTime @db.Date
  description String
  rawText     String   @db.Text
  confidence  String   @default("MEDIUM") @db.VarChar(10)
  alertId     String?  @map("alert_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  firm     Firm      @relation(fields: [firmId], references: [id], onDelete: Cascade)
  document Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  client   Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([firmId])
  @@index([firmId, date])
  @@index([documentId])
  @@map("extracted_deadlines")
}

// ─── Alerts ──────────────────────────────────────────

model Alert {
  id          String    @id @default(cuid())
  firmId      String    @map("firm_id") @db.Uuid
  clientId    String?   @map("client_id") @db.Uuid
  type        AlertType
  severity    Severity  @default(MEDIUM)
  title       String
  body        String    @db.Text
  metadata    Json      @default("{}") @db.JsonB
  isRead      Boolean   @default(false) @map("is_read")
  resolvedAt  DateTime? @map("resolved_at") @db.Timestamptz()
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz()

  firm   Firm    @relation(fields: [firmId], references: [id], onDelete: Cascade)
  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([firmId])
  @@index([firmId, type, isRead])
  @@index([firmId, severity])
  @@map("alerts")
}

// ─── Daily Briefings ─────────────────────────────────

model DailyBriefing {
  id          String   @id @default(cuid())
  firmId      String   @map("firm_id") @db.Uuid
  date        DateTime @db.Date
  summary     String   @db.Text
  clientCount Int      @default(0) @map("client_count")
  alertCount  Int      @default(0) @map("alert_count")
  metadata    Json     @default("{}") @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@unique([firmId, date])
  @@index([firmId])
  @@map("daily_briefings")
}

// ─── Firm Invites ─────────────────────────────────────────────────────

model FirmInvite {
  id        String    @id @default(cuid())
  firmId    String    @map("firm_id") @db.Uuid
  createdBy String    @map("created_by") @db.Uuid
  token     String    @unique @db.VarChar(64)
  email     String?   @db.VarChar(255)
  role      UserRole  @default(member)
  usedBy    String?   @map("used_by") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz()
  usedAt    DateTime? @map("used_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  firm       Firm  @relation(fields: [firmId], references: [id], onDelete: Cascade)
  creator    User  @relation("InviteCreator", fields: [createdBy], references: [id])
  usedByUser User? @relation("InviteAcceptor", fields: [usedBy], references: [id])

  @@index([firmId])
  @@index([token])
  @@map("firm_invites")
}
