# ─── Server ───────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_accounting?schema=public

# ─── Redis ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Google OAuth ─────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# ─── OpenAI ───────────────────────────────────────────
OPENAI_API_KEY=

# ─── AWS S3 ───────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_S3_BUCKET=

# ─── JWT ──────────────────────────────────────────────
JWT_SECRET=change-me-in-production

# ─── Encryption ───────────────────────────────────────
ENCRYPTION_KEY=change-me-32-byte-key-in-prod!!!
