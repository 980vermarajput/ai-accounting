# ─── Server ───────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ─── Database ─────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_accounting?schema=public

# ─── Row-Level Security (tenant isolation backstop) ───
# Off by default. To enforce DB-level RLS, see apps/api/prisma/rls/README.md:
#   1. point DATABASE_URL at the restricted `app_user` role
#   2. set ADMIN_DATABASE_URL to a superuser/BYPASSRLS connection for privileged flows
#   3. set RLS_ENFORCE=true
RLS_ENFORCE=false
# ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_accounting?schema=public

# ─── Redis ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Google OAuth ─────────────────────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
# Scopes required: gmail.readonly, drive.readonly, userinfo.email, userinfo.profile
# Authorized redirect URI: http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
FRONTEND_URL=http://localhost:3000

# ─── Sync limits ──────────────────────────────────────
# Max emails/files fetched per sync job. Keep low (25) in dev, set 500+ in prod.
SYNC_MAX_RESULTS=25
# Max emails to process per firm to prevent cost explosions
MAX_EMAILS_PER_SYNC=10000
# Default sync period (months) - only sync emails from last N months
DEFAULT_SYNC_MONTHS=24
# Skip emails from these domains/patterns (comma-separated)
SKIP_EMAIL_PATTERNS="noreply,newsletter,unsubscribe,no-reply,donotreply"

# ─── JWT ──────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# ─── Encryption (AES-256-GCM for Google refresh tokens) ──────────
# Key MUST be exactly 32 bytes (64 hex chars)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=change-me-32-byte-hex-key-must-be-64-chars-long00

# ─── OpenAI ───────────────────────────────────────────
OPENAI_API_KEY=

# ─── Spend Protection ─────────────────────────────────
# Daily token limits to prevent cost explosions
DAILY_TOKEN_CAP_PER_FIRM=50000
MAX_QUERY_TOKENS=6000
DAILY_GLOBAL_TOKEN_ALERT=500000

# ─── AWS S3 ───────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_S3_BUCKET=

# ─── Telegram Bot ─────────────────────────────────────
# Create bot via @BotFather on Telegram
# Commands to register: /setcommands
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Secret for webhook verification (generate random string)
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=

# ─── WhatsApp (AiSensy BSP) ───────────────────────────
# AiSensy API key (long-lived JWT from AiSensy dashboard → Manage → API Key)
AISENSY_API_KEY=
# Override only if AiSensy changes the host; default https://backend.aisensy.com
AISENSY_API_BASE=
# Your WhatsApp business number (digits only, with country code) shown in the
# linking UI, e.g. 919999999999
WHATSAPP_BUSINESS_NUMBER=
# Shared secret for inbound webhook verification (query ?secret= or X-Webhook-Secret header)
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WHATSAPP_WEBHOOK_SECRET=
# AiSensy campaign names — each must map to an approved WhatsApp template.
# Submit these for approval early (approval is the long-pole item).
#   compliance_alert  body params: [severity·type, title, body]
#   daily_briefing    body params: [summary]
#   session_reply     body params: [text]   (one-variable, for dynamic replies)
WHATSAPP_TEMPLATE_ALERT=compliance_alert
WHATSAPP_TEMPLATE_BRIEFING=daily_briefing
WHATSAPP_TEMPLATE_SESSION=session_reply
